{
  "name": "workspace-bridge-pi-host-adapter",
  "version": "0.1.1",
  "workspaceBridgeRelease": "0.1.1",
  "type": "module",
  "description": "Native host adapter that owns in-process Pi AgentSession instances for Workspace Bridge. Not a Compose service.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sheldonxxxx/workspace-bridge",
    "directory": "runtime/pi-host-adapter"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "bin": {
    "workspace-bridge-pi-adapter": "pi-adapter.mjs"
  },
  "files": [
    "adapter.mjs",
    "config.mjs",
    "executions.mjs",
    "extensions.mjs",
    "fingerprint.mjs",
    "logging.mjs",
    "login-path.mjs",
    "main.mjs",
    "paths.mjs",
    "pi-adapter.mjs",
    "policy.mjs",
    "release.mjs",
    "sdk-events.mjs",
    "sdk-transport.mjs",
    "server.mjs",
    "trusted-permission-extension.mjs",
    "wbrp.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0"
  },
  "scripts": {
    "start": "node main.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
