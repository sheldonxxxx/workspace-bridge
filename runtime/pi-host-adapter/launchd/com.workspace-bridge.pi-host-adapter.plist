<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Workspace Bridge Pi host adapter LaunchAgent template (native macOS only).

  This file is an EXAMPLE. It is never installed automatically: the adapter
  implementation does not load/unload launchd, write ~/Library/LaunchAgents,
  create directories, or alter shell rc files. To use it, copy it to
  ~/Library/LaunchAgents/ yourself after replacing EVERY __HOME__ placeholder
  with your real absolute home path (launchd performs no shell expansion, so
  $HOME must not appear here), then set the required environment values below.

  Required:
    WB_RUNTIME_TOKEN      shared token; empty locks every operational endpoint.
    WB_PI_PROJECTS_DIR    absolute dedicated projects parent (must already exist).

  Optional:
    WB_PI_BINARY          Pi executable; default "pi". Never installed/upgraded.
    PI_CODING_AGENT_DIR   isolated Pi agent dir; default ~/.pi/workspace-bridge.
    WB_PI_ADAPTER_HOST    default 127.0.0.1 (keep loopback; do not broaden).
    WB_PI_ADAPTER_PORT    default 8780.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.workspace-bridge.pi-host-adapter</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>__HOME__/workspace-bridge/runtime/pi-host-adapter/main.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WB_RUNTIME_TOKEN</key>
    <string>REPLACE_WITH_SHARED_TOKEN</string>
    <key>WB_PI_PROJECTS_DIR</key>
    <string>__HOME__/Projects</string>
    <key>WB_PI_BINARY</key>
    <string>pi</string>
    <key>PI_CODING_AGENT_DIR</key>
    <string>__HOME__/.pi/workspace-bridge</string>
    <key>WB_PI_ADAPTER_HOST</key>
    <string>127.0.0.1</string>
    <key>WB_PI_ADAPTER_PORT</key>
    <string>8780</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/workspace-bridge-pi-adapter.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/workspace-bridge-pi-adapter.err</string>
  <key>WorkingDirectory</key>
  <string>__HOME__/workspace-bridge/runtime/pi-host-adapter</string>
</dict>
</plist>
