# Copy to .env and replace every path/ID, or use scripts/configure_docker.py.
# Use absolute canonical paths. Never put tokens/API keys here (the OpenCode
# provider credentials and the Discord webhook stay in this local .env only and
# are never exposed through MCP, the manager, events or logs).
WB_UID=1000
WB_GID=1000
WB_PROJECTS_DIR='/home/you/Projects'
WB_STATE_DIR='/home/you/.local/state/workspace-bridge-docker'
# Host ports only. Internal ports stay 8765/8766. The OpenCode adapter publishes none.
WB_MCP_PORT=8765
WB_ADMIN_PORT=8766

# --- OpenCode runtime (optional; agent execution stays disabled until enabled per workspace) ---
# The OpenCode server runs NATIVELY on the host and is managed by the user.
# Docker Desktop:  WB_OPENCODE_SERVER_URL=http://host.docker.internal:4096
# Linux Engine:    set an explicit reachable host URL and keep the server bound narrowly.
WB_OPENCODE_SERVER_URL=
WB_OPENCODE_SERVER_USERNAME=
WB_OPENCODE_SERVER_PASSWORD=
# Agent execution is OPTIONAL and stays locked until you set WB_RUNTIME_TOKEN.
# The private adapter denies every operational endpoint when the token is empty,
# so an unset token fails closed instead of allowing any Compose-network caller.
# Use a random value shared by the bridge and the adapter; never commit it.
WB_RUNTIME_TOKEN=

# --- Discord notifications (optional) ---
# Sent on waiting_permission, waiting_question, completed, blocked, failed and cancelled.
# Safe metadata only; never returned by any API or written to project files.
WB_DISCORD_WEBHOOK_URL=

# Optional reviewed base-image pin:
# WB_PYTHON_IMAGE=python:3.13-slim-bookworm@sha256:YOUR_REVIEWED_DIGEST
