# Copy to .env and replace every path/ID, or use scripts/configure_docker.py.
# Use absolute canonical paths. Never put tokens/API keys here (the OpenCode
# provider credentials and the Discord webhook stay in this local .env only and
# are never exposed through MCP, the manager, events or logs).
WB_UID=1000
WB_GID=1000
WB_PROJECTS_DIR='/home/you/Projects'
WB_STATE_DIR='/home/you/.local/state/workspace-bridge-docker'
# Host ports only. Internal ports stay 8765/8766. The OpenCode adapter publishes none.
WB_MCP_PORT=8765
WB_ADMIN_PORT=8766

# --- Remote admin allowlist (optional, admin only; MCP stays loopback) ---
# Bare hostnames/IPs, comma-separated, no ports/schemes/wildcards. Empty (default)
# keeps the manager loopback-only. When set, the admin listener binds 0.0.0.0 and
# allows those Host values (http + https origins). MCP is unaffected.
# Prefer SSH port-forwarding or VPN; HTTP bears the admin token in clear unless
# you terminate TLS in front. Never tunnel the manager. Docker also requires
# changing the admin published port to reach LAN (default stays 127.0.0.1).
# Example: WB_ADMIN_ALLOWED_HOSTS=admin.lan,192.168.1.10
WB_ADMIN_ALLOWED_HOSTS=

# --- OpenCode runtime (optional; agent execution stays disabled until enabled per workspace) ---
# The OpenCode server runs NATIVELY on the host and is managed by the user.
# Docker Desktop:  WB_OPENCODE_SERVER_URL=http://host.docker.internal:4096
# Linux Engine:    set an explicit reachable host URL and keep the server bound narrowly.
WB_OPENCODE_SERVER_URL=
WB_OPENCODE_SERVER_USERNAME=
WB_OPENCODE_SERVER_PASSWORD=
# Agent execution is OPTIONAL and stays locked until you set WB_RUNTIME_TOKEN.
# The private adapter denies every operational endpoint when the token is empty,
# so an unset token fails closed instead of allowing any Compose-network caller.
# Use a random value shared by the bridge and the adapter; never commit it.
WB_RUNTIME_TOKEN=

# --- Pi host adapter (optional, milestone 3A2: diagnostics/registry only) ---
# Native macOS Pi adapter URL seen from inside the bridge container.
# Example: WB_PI_RUNTIME_URL=http://host.docker.internal:8780
# Empty (default) leaves Pi unconfigured. Provider/Pi credentials stay on the
# Mac Pi process; the bridge receives only this URL plus WB_RUNTIME_TOKEN.
# Keep the adapter bound narrowly. Verified on this host under OrbStack 29.4.0:
# the container host.docker.internal gateway reached the native 127.0.0.1-bound
# adapter. Docker Desktop behavior may differ and must be smoke-tested; never
# broaden to 0.0.0.0/LAN.
WB_PI_RUNTIME_URL=

# --- Operational container logs ---
# One-line JSON records on docker compose logs -f bridge opencode-adapter.
# DEBUG/INFO/WARNING/ERROR, default INFO. The bridge fails fast at startup on
# an invalid value; the adapter safely falls back to INFO with a warning.
# Uvicorn access logs stay disabled.
WB_LOG_LEVEL=INFO

# --- Discord notifications (optional) ---
# Sent on waiting_permission, waiting_question, completed, blocked, failed and cancelled.
# Safe metadata only; never returned by any API or written to project files.
WB_DISCORD_WEBHOOK_URL=

# Optional reviewed base-image pin:
# WB_PYTHON_IMAGE=python:3.13-slim-bookworm@sha256:YOUR_REVIEWED_DIGEST
