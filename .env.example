# Copy to .env and replace every path/ID, or use scripts/configure_docker.py.
# Use absolute canonical paths. Never put tokens/API keys here (the Pi provider
# credentials and the Discord webhook stay in this local .env only and
# are never exposed through MCP, the manager, events or logs).
WB_UID=1000
WB_GID=1000
WB_PROJECTS_DIR='/home/you/Projects'
WB_STATE_DIR='/home/you/.local/state/workspace-bridge-docker'
# Host ports only. Internal ports stay 8765/8766. The native Pi adapter publishes none.
WB_MCP_PORT=8765
WB_ADMIN_PORT=8766

# --- Remote admin allowlist (optional, admin only; MCP stays loopback) ---
# Bare hostnames/IPs, comma-separated, no ports/schemes/wildcards. Empty (default)
# keeps the manager loopback-only. When set, the admin listener binds 0.0.0.0 and
# allows those Host values (http + https origins). MCP is unaffected.
# Prefer SSH port-forwarding or VPN; HTTP bears the admin token in clear unless
# you terminate TLS in front. Never tunnel the manager. Docker also requires
# changing the admin published port to reach LAN (default stays 127.0.0.1).
# Example: WB_ADMIN_ALLOWED_HOSTS=admin.lan,192.168.1.10
WB_ADMIN_ALLOWED_HOSTS=

# Runtime Protocol v1 adapters. JSON maps stable runtime IDs to private host
# URLs reachable from the bridge container, for example:
# WB_RUNTIME_ADAPTERS={"pi":"http://host.docker.internal:8780","codex":"http://host.docker.internal:8772"}
# Per-workspace runtime grants, profile bindings and model policies remain
# disabled until explicitly configured in the local manager.
WB_RUNTIME_ADAPTERS={}
# Agent execution is OPTIONAL and stays locked until you set WB_RUNTIME_TOKEN.
# The private adapter denies every operational endpoint when the token is empty,
# so an unset token fails closed instead of allowing any Compose-network caller.
# Use a random value shared by the bridge and the adapter; never commit it.
WB_RUNTIME_TOKEN=

# --- Operational container logs ---
# One-line JSON records on docker compose logs -f bridge.
# DEBUG/INFO/WARNING/ERROR, default INFO. The bridge fails fast at startup on
# an invalid value. Uvicorn access logs stay disabled.
WB_LOG_LEVEL=INFO

# --- Tunnel sidecar logs (non-secret) ---
# Maps to the tunnel client's LOG_LEVEL (tunnel vocabulary: debug/info/warn
# only, default info) with LOG_FORMAT=json set in both Compose files.
# Never enable raw HTTP tunnel logging (LOG_HTTP_RAW_UNSAFE): it may expose
# sensitive headers/bodies. Independent from WB_LOG_LEVEL and host adapters'
# own WB_LOG_LEVEL settings.
WB_TUNNEL_LOG_LEVEL=info

# --- Discord notifications (optional) ---
# Sent when a run needs attention and when a run reaches a terminal outcome.
# Safe metadata only; never returned by any API or written to project files.
WB_DISCORD_WEBHOOK_URL=

# Optional reviewed base-image pin:
# WB_PYTHON_IMAGE=python:3.13-slim-bookworm@sha256:YOUR_REVIEWED_DIGEST
