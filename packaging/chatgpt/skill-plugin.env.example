# Copy to repository-root .env.skill-plugin, then replace the three placeholders.
# This is private binding metadata, not an API key. Never commit the filled file.
WB_SKILL_PLUGIN_APP_ID=plugin_asdk_app_example123
WB_SKILL_PLUGIN_PACKAGE_NAME=My_Existing_Plugin
WB_SKILL_PLUGIN_PACKAGE_VERSION=1.0.0

# true only after verifying the existing release embeds the exact selected skill.
# Set false for a new plugin or an existing release that still needs the skill.
WB_SKILL_PLUGIN_ALREADY_PACKAGED=true

# Optional settings; leave commented to use existing defaults or saved state.
# File paths are literal and relative to this env file's directory, or absolute.
# No dollar variables, tilde expansion, command substitutions, or shell source.
# Keep state/artifacts outside tracked source. Choose an actual private directory.
# WB_SKILL_PLUGIN_STATE=/path/to/private-skill-plugin-state
# WB_SKILL_PLUGIN_APP_ALIAS=workspace-bridge
# WB_SKILL_PLUGIN_TEMPLATE=packaging/chatgpt/plugin.json
# WB_SKILL_PLUGIN_SKILL=workspace_bridge/skills/project-lead/SKILL.md
# Leave OUTPUT unset for versioned ZIP paths in the private state directory.
# WB_SKILL_PLUGIN_OUTPUT=/path/to/new-upload.zip
